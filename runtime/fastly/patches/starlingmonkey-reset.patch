 void EventLoop::init(JSContext *cx) { queue.init(cx); }

+void EventLoop::reset(api::Engine *engine) {
+  auto &q = queue.get();
+  for (auto task : q.tasks) {
+    task->cancel(engine);
+  }
+  q.tasks.clear();
+  q.interest_cnt = 0;
+}
+
 } // namespace core
